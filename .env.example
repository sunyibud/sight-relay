# Sight Relay Server 本地/开发配置模板
# 复制为 .env 后再填写密码和当前供应商的 API Key：
#   cp .env.example .env

# 仅当 SIGHT_DATA_DIR/app.db 中还没有用户时，用于创建初始管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SIGHT_DATA_DIR=./data
SIGHT_BIND_ADDR=0.0.0.0:8080

# 当前使用的供应商：openai / dashscope / deepseek / kimi / zhipu / minimax / other
AI_PROVIDER=openai

# OpenAI 兼容 Chat Completions 配置。每个供应商的配置可在管理员设置页热切换。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=
OPENAI_THINKING_MODE=auto
OPENAI_THINKING_KEEP=null
OPENAI_CLEAR_THINKING=true
OPENAI_EXTRA_BODY_JSON={}
OPENAI_API_KEY=

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_PROXY=
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_REASONING_EFFORT=
DASHSCOPE_THINKING_MODE=disabled
DASHSCOPE_THINKING_KEEP=null
DASHSCOPE_CLEAR_THINKING=true
DASHSCOPE_EXTRA_BODY_JSON={}
DASHSCOPE_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_THINKING_KEEP=null
DEEPSEEK_CLEAR_THINKING=true
DEEPSEEK_EXTRA_BODY_JSON={}
DEEPSEEK_API_KEY=

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_PROXY=
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=
KIMI_THINKING_MODE=disabled
KIMI_THINKING_KEEP=null
KIMI_CLEAR_THINKING=true
KIMI_EXTRA_BODY_JSON={}
KIMI_API_KEY=

ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_PROXY=
ZHIPU_MODEL=glm-5.2
ZHIPU_REASONING_EFFORT=minimal
ZHIPU_THINKING_MODE=disabled
ZHIPU_THINKING_KEEP=null
ZHIPU_CLEAR_THINKING=true
ZHIPU_EXTRA_BODY_JSON={}
ZHIPU_API_KEY=

MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_PROXY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_REASONING_EFFORT=
MINIMAX_THINKING_MODE=disabled
MINIMAX_THINKING_KEEP=null
MINIMAX_CLEAR_THINKING=true
MINIMAX_EXTRA_BODY_JSON={}
MINIMAX_API_KEY=

# 自定义 OpenAI 兼容供应商。OTHER_EXTRA_BODY_JSON 不能覆盖系统保留字段。
OTHER_BASE_URL=
OTHER_PROXY=
OTHER_MODEL=
OTHER_REASONING_EFFORT=
OTHER_THINKING_MODE=auto
OTHER_THINKING_KEEP=null
OTHER_CLEAR_THINKING=true
OTHER_EXTRA_BODY_JSON={}
OTHER_API_KEY=

# Prompt 文件。Server 首次启动时会把文件内容写入 SQLite 热配置表。
SIGHT_PROMPT_FILE=.sight-prompt.md
SIGHT_MULTI_PAGE_PROMPT_FILE=.sight-multi-page-prompt.md
# 同时执行的解析任务数，代码会限制在 1–16。
SIGHT_ANALYSIS_CONCURRENCY=2

# MinIO/S3 可选。以下配置按需全部填写；不填写时图片存储在
# ${SIGHT_DATA_DIR}/captures/。
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_BUCKET=sight-relay
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1

# 仅 CLI/开发调试使用。正常 Capture Token 应在 Server 的 Capture 设备页生成。
# SIGHT_DEVICE_TOKEN=replace-with-generated-device-token
