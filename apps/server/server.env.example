# Sight Relay Server 生产环境配置模板
# 建议复制到 /etc/sight-relay/server.env，并将文件权限设为 root:sightrelay 0640。

# 仅当数据目录中还没有用户时，用于创建初始管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SIGHT_DATA_DIR=/var/lib/sight-relay
SIGHT_BIND_ADDR=0.0.0.0:8080

# 当前使用的供应商：openai / dashscope / deepseek / kimi / zhipu / minimax / other
AI_PROVIDER=openai

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=
OPENAI_THINKING_MODE=auto
OPENAI_THINKING_KEEP=null
OPENAI_CLEAR_THINKING=true
OPENAI_EXTRA_BODY_JSON={}
OPENAI_API_KEY=

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_PROXY=
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_REASONING_EFFORT=
DASHSCOPE_THINKING_MODE=disabled
DASHSCOPE_THINKING_KEEP=null
DASHSCOPE_CLEAR_THINKING=true
DASHSCOPE_EXTRA_BODY_JSON={}
DASHSCOPE_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_THINKING_KEEP=null
DEEPSEEK_CLEAR_THINKING=true
DEEPSEEK_EXTRA_BODY_JSON={}
DEEPSEEK_API_KEY=

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_PROXY=
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=
KIMI_THINKING_MODE=disabled
KIMI_THINKING_KEEP=null
KIMI_CLEAR_THINKING=true
KIMI_EXTRA_BODY_JSON={}
KIMI_API_KEY=

ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_PROXY=
ZHIPU_MODEL=glm-5.2
ZHIPU_REASONING_EFFORT=minimal
ZHIPU_THINKING_MODE=disabled
ZHIPU_THINKING_KEEP=null
ZHIPU_CLEAR_THINKING=true
ZHIPU_EXTRA_BODY_JSON={}
ZHIPU_API_KEY=

MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_PROXY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_REASONING_EFFORT=
MINIMAX_THINKING_MODE=disabled
MINIMAX_THINKING_KEEP=null
MINIMAX_CLEAR_THINKING=true
MINIMAX_EXTRA_BODY_JSON={}
MINIMAX_API_KEY=

# 自定义 OpenAI 兼容供应商。
OTHER_BASE_URL=
OTHER_PROXY=
OTHER_MODEL=
OTHER_REASONING_EFFORT=
OTHER_THINKING_MODE=auto
OTHER_THINKING_KEEP=null
OTHER_CLEAR_THINKING=true
OTHER_EXTRA_BODY_JSON={}
OTHER_API_KEY=

SIGHT_PROMPT_FILE=/var/lib/sight-relay/.sight-prompt.md
SIGHT_MULTI_PAGE_PROMPT_FILE=/var/lib/sight-relay/.sight-multi-page-prompt.md
# 同时执行的解析任务数，代码会限制在 1–16。
SIGHT_ANALYSIS_CONCURRENCY=2

# MinIO/S3 可选。不填写时图片存储在 /var/lib/sight-relay/captures/。
# 启用时请完整填写以下配置，并先创建 bucket。
# MINIO_ENDPOINT=https://minio.example.com
# MINIO_BUCKET=sight-relay
# MINIO_ACCESS_KEY=replace-me
# MINIO_SECRET_KEY=replace-me
# MINIO_REGION=us-east-1
